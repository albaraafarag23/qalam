{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qalam",
  "version": "0.1.0",
  "identifier": "dev.qalam.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Qalam",
        "width": 1280,
        "height": 860,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "dictionaries/*": "dictionaries/"
    },
    "fileAssociations": [
      {
        "ext": [
          "qalam"
        ],
        "name": "Qalam document",
        "description": "A document written in Qalam",
        "role": "Editor",
        "mimeType": "application/x-qalam"
      }
    ]
  }
}
